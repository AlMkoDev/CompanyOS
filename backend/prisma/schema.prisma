generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  logo_url        String?
  brand_colors    Json? // { primary: string, secondary: string, accent: string }
  tagline         String?
  contact_details Json? // { email: string, phone: string, address: string }
  industry        String?
  description     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  users                User[]
  departments          Department[]
  setup                CompanySetup?
  tasks                Task[]
  documents            Document[]
  activity_logs        ActivityLog[]
  roles                Role[]
  permissions          Permission[]
  sops                 SOP[]
  gap_statuses         GapStatus[]
  kpis                 KPI[]
  nativeModules        NativeModule[]
  platformTasks        PlatformTask[]
  roadmapTasks         RoadmapTask[]
  glaccounts           GLAccount[]
  journalEntries       JournalEntry[]
  accountingPeriods    AccountingPeriod[]
  bankStatements       BankStatement[]
  trialBalances        TrialBalance[]
  vendors              Vendor[]
  purchaseOrders       PurchaseOrder[]
  invoices             Invoice[]
  goodsReceipts        GoodsReceipt[]
  paymentRuns          PaymentRun[]
  vendorStatements     VendorStatement[]
  customers            Customer[]
  arinvoices           ARInvoice[]
  payments             Payment[]
  creditMemos          CreditMemo[]
  collectionCases      CollectionCase[]
  disputeCases         DisputeCase[]
  disputeActivities    DisputeActivity[]
  disputeResolutions   DisputeResolution[]
  disputeAttachments   DisputeAttachment[]
  disputeDocuments     DisputeDocument[]
  cashForecasts        CashForecast[]
  scenarioAssumptions  ScenarioAssumption[]
  salaryRecords        SalaryRecord[]
  payrollRuns          PayrollRun[]
  bankPaymentFiles     BankPaymentFile[]
  positions            Position[]
  employees            Employee[]
  jobRequisitions      JobRequisition[]
  reviewCycles         ReviewCycle[]
  reviews              Review[]
  ratingScales         RatingScale[]
  courses              Course[]
  trainingPlans        TrainingPlan[]
  hrtickets            HRTicket[]
  surveys              Survey[]
  deimetrics           DEIMetric[]
  projects             Project[]
  resources            Resource[]
  ncrs                 NCR[]
  auditChecklists      AuditChecklist[]
  auditFindings        AuditFinding[]
  products             Product[]
  assets               Asset[]
  hseincidents         HSEIncident[]
  riskAssessments      RiskAssessment[]
  environmentalPermits EnvironmentalPermit[]
  improvementIdeas     ImprovementIdea[]
  initiatives          Initiative[]
  processMaps          ProcessMap[]
  campaigns            Campaign[]
  editorialCalendars   EditorialCalendar[]
  utmtags              UTMTag[]
  brandAssets          BrandAsset[]
  assetCollections     AssetCollection[]
  crmcontacts          CRMContact[]
  crmaccounts          CRMAccount[]
  deals                Deal[]
  activities           Activity[]
  contractTemplates    ContractTemplate[]
  contracts            Contract[]
  complianceDeadlines  ComplianceDeadline[]
  dataProcessors       DataProcessor[]
  dsrrequests          DSRRequest[]
  ittickets            ITTicket[]
  itassets             ITAsset[]
  changerequests       ChangeRequest[]
  knowledgearticles    KnowledgeArticle[]
  okrcycles            OKRCycle[]
  kpisnapshots         KPISnapshot[]
  folders              Folder[]
  retentionPolicies    RetentionPolicy[]
  spendRecords         SpendRecord[]
  travelRequests       TravelRequest[]
  expenseClaims        ExpenseClaim[]
  vehicles             Vehicle[]
  suppliers            Supplier[]
  opsPurchaseOrders    OpsPurchaseOrder[]
  poAmendments         POAmendment[]
  poAmendmentAudits    POAmendmentAudit[]
  opsGoodsReceipts     OpsGoodsReceipt[]
  purchaseRequisitions PurchaseRequisition[]
  approvalPolicies     ApprovalPolicy[]
  locations            Location[]
  stockLevels          StockLevel[]
  stockLedgers         StockLedger[]
  bankReconciliationMatches BankReconciliationMatch[]
  apRequisitions       APRequisition[]
  apManualEntries      APManualEntry[]
  apMatchExceptions    APMatchException[]
  apAuditTrails        APAuditTrail[]
  accountOwners        GLAccount[] @relation("GLAccountOwner")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  first_name    String
  last_name     String
  avatar_url    String?
  mfa_enabled   Boolean  @default(false)
  mfa_secret    String?
  status        String   @default("active") // active, inactive, pending
  company_id    String   @db.Uuid
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  company            Company            @relation(fields: [company_id], references: [id])
  department_members DepartmentMember[]
  tasks_assigned     Task[]             @relation("AssignedTasks")
  tasks_created      Task[]             @relation("CreatedTasks")
  activity_logs      ActivityLog[]
  bank_change_requests_made BankChangeRequest[] @relation("BankChangeRequester")
  bank_change_requests_approved BankChangeRequest[] @relation("BankChangeApprover")
  bankReconciliationMatches BankReconciliationMatch[]
  apRequisitionRequests APRequisition[] @relation("APRequisitionRequester")
  apRequisitionApprovals APRequisition[] @relation("APRequisitionApprover")
  apManualEntryRequests APManualEntry[] @relation("APManualEntryRequester")
  apManualEntryApprovals APManualEntry[] @relation("APManualEntryApprover")
  apMatchExceptionsRaised APMatchException[] @relation("APMatchExceptionRaisedBy")
  apMatchExceptionsResolved APMatchException[] @relation("APMatchExceptionResolvedBy")
  apAuditTrails       APAuditTrail[] @relation("APAuditTrailActor")
  disputesAssigned    DisputeCase[] @relation("DisputeAssignee")
  disputesCreated     DisputeCase[] @relation("DisputeCreator")
  disputeActivities   DisputeActivity[] @relation("DisputeActivityActor")
  disputeActivityTasksAssigned DisputeActivity[] @relation("DisputeActivityTaskAssignee")
  disputeResolutionsApproved DisputeResolution[] @relation("DisputeResolutionApprover")
  disputeAttachmentsUploaded DisputeAttachment[] @relation("DisputeAttachmentUploader")
  disputeDocumentsGenerated DisputeDocument[] @relation("DisputeDocumentGenerator")
}

model Department {
  id           String  @id @default(uuid()) @db.Uuid
  company_id   String  @db.Uuid
  template_key String? // e.g., 'fin', 'hr', 'ops'
  name         String

  description           String?
  icon                  String?
  color                 String?
  mandate               Json? // { mission: string, objectives: string[], scope: string }
  core_responsibilities String?
  deliverables          String?
  roles                 Json? // Array of Role objects
  operational_routines  Json? // Daily/Weekly/Monthly routines
  data_pack             Json? // Systems and data assets
  activities            Json? // Detailed sub-sections and activities
  communication_lines   Json? // Information flows between roles
  budget_allocation     Decimal? @db.Decimal(15, 2)
  status                String   @default("active")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Relations
  company            Company             @relation(fields: [company_id], references: [id])
  members            DepartmentMember[]
  tasks              Task[]
  documents          Document[]
  sops               SOP[]
  gap_statuses       GapStatus[]
  kpis               KPI[]
  nativeModules      NativeModule[]
  employees          Employee[]
  positions          Position[]
  jobRequisitions    JobRequisition[]
  employment_history EmploymentHistory[]

  @@unique([company_id, template_key], name: "companyId_templateKey")
}

model DepartmentMember {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  department_id String   @db.Uuid
  role_id       String?  @db.Uuid
  is_head       Boolean  @default(false)
  joined_at     DateTime @default(now())

  // Relations
  user       User       @relation(fields: [user_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])
  role       Role?      @relation(fields: [role_id], references: [id])

  @@unique([user_id, department_id])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  name        String
  description String?
  level       Int // 1: Super Admin, 2: Dept Admin, 3: Manager, 4: Contributor, 5: Viewer
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  company            Company            @relation(fields: [company_id], references: [id])
  permissions        RolePermission[]
  department_members DepartmentMember[]
}

model Permission {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  action     String // e.g., "create", "read", "update", "delete"
  resource   String // e.g., "tasks", "documents", "users"
  effect     String   @default("allow") // allow or deny
  created_at DateTime @default(now())

  // Relations
  company Company          @relation(fields: [company_id], references: [id])
  roles   RolePermission[]
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  // Relations
  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
}

model Task {
  id            String    @id @default(uuid()) @db.Uuid
  company_id    String    @db.Uuid
  department_id String    @db.Uuid
  title         String
  task_code     String? // e.g., "F-K01", "H-W03"
  task_category String? // kpi_config, operation_workflow, gap_closure, module_build, platform, roadmap
  description   String?
  status        String    @default("open") // open, in-progress, review, done
  priority      String    @default("medium") // low, medium, high, critical
  creator_id    String    @db.Uuid
  assignee_id   String?   @db.Uuid
  due_date      DateTime?
  attachments   Json? // Array of file URLs/references
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  company    Company    @relation(fields: [company_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])
  creator    User       @relation("CreatedTasks", fields: [creator_id], references: [id])
  assignee   User?      @relation("AssignedTasks", fields: [assignee_id], references: [id])

  @@unique([company_id, task_code])
}

model Document {
  id             String   @id @default(uuid()) @db.Uuid
  company_id     String   @db.Uuid
  department_id  String?  @db.Uuid
  folder_id      String?  @db.Uuid
  retention_id   String?  @db.Uuid
  name           String
  file_url       String
  file_type      String
  size_bytes     Int
  status         String   @default("draft") // draft, published, archived
  classification String   @default("internal") // internal, confidential, secret
  tags           String[]
  version        Int      @default(1)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  company          Company           @relation(fields: [company_id], references: [id])
  department       Department?       @relation(fields: [department_id], references: [id])
  folder           Folder?           @relation(fields: [folder_id], references: [id])
  retention_policy RetentionPolicy?  @relation(fields: [retention_id], references: [id])
  versions         DocumentVersion[]
  legal_holds      LegalHold[]
}

model ActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  company_id    String   @db.Uuid
  user_id       String?  @db.Uuid
  action        String
  resource_type String
  resource_id   String?
  details       Json?
  ip_address    String?
  user_agent    String?
  created_at    DateTime @default(now())

  // Relations
  company Company @relation(fields: [company_id], references: [id])
  user    User?   @relation(fields: [user_id], references: [id])
}

model CompanySetup {
  id              String   @id @default(uuid()) @db.Uuid
  company_id      String   @unique @db.Uuid
  current_step    Int      @default(1)
  is_complete     Boolean  @default(false)
  steps_config    Json? // Tracks progress per step
  completed_steps Int[]    @default([])
  updated_at      DateTime @updatedAt

  // Relations
  company Company @relation(fields: [company_id], references: [id])
}

model KPI {
  id            String   @id @default(uuid()) @db.Uuid
  company_id    String   @db.Uuid
  department_id String   @db.Uuid
  name          String
  description   String?
  formula       String? // How it's calculated
  data_source   String? // Where the data comes from
  owner_role    String? // The role responsible for this KPI
  frequency     String   @default("monthly") // daily, weekly, monthly, quarterly
  unit          String // percentage, currency, count, etc.
  kpi_code      String?
  target        Decimal? @db.Decimal(15, 2)
  current_value Decimal? @db.Decimal(15, 2)
  status        String   @default("on-track") // on-track, at-risk, off-track
  last_updated  DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  company    Company    @relation(fields: [company_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])

  @@unique([company_id, kpi_code])
}

model SOP {
  id                String   @id @default(uuid()) @db.Uuid
  company_id        String   @db.Uuid
  department_id     String   @db.Uuid
  title             String
  purpose           String?
  scope             String?
  trigger           String?
  raci              Json? // { responsible: string[], accountable: string[], consulted: string[], informed: string[] }
  procedure         Json? // Array of steps: { step: number, action: string, role: string, system: string }
  approval_matrix   Json? // { thresholds: any[], escalations: any[] }
  output_standard   String?
  systems_used      String[]
  exceptions        Json? // Array of items: { condition: string, response: string }
  related_documents Json? // Links to policy, systems guides, etc.
  status            String   @default("draft") // draft, active, archived
  version           Int      @default(1)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  company    Company    @relation(fields: [company_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])
}

model GapStatus {
  id            String    @id @default(uuid()) @db.Uuid
  company_id    String    @db.Uuid
  department_id String    @db.Uuid
  gap_type      String // Process, Technology, Data
  gap_code      String? // e.g., "F-G01"
  item_name     String
  description   String?
  priority      String    @default("medium") // critical, high, medium, low
  status        String    @default("identified") // identified, in-progress, closed
  owner_id      String?   @db.Uuid
  target_date   DateTime?
  closed_at     DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  company    Company    @relation(fields: [company_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])
}

model NativeModule {
  id            String   @id @default(uuid()) @db.Uuid
  company_id    String   @db.Uuid
  module_code   String // e.g., "VF-FIN-001"
  name          String
  department_id String   @db.Uuid
  priority      String // P0, P1, P2, P3
  build_time    String? // e.g., "8-10 weeks"
  status        String   @default("planned") // planned, in-progress, completed
  phase         Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  company    Company    @relation(fields: [company_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])

  @@unique([company_id, module_code])
}

model PlatformTask {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  task_code  String // e.g., "P-01", "G-01"
  title      String
  category   String // infrastructure, governance
  priority   String   @default("medium")
  status     String   @default("pending")
  owner      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, task_code])
}

model RoadmapTask {
  id           String   @id @default(uuid()) @db.Uuid
  company_id   String   @db.Uuid
  phase        Int
  sprint       String?
  story_id     String // e.g., "INF-001"
  title        String
  module       String?
  points       Int      @default(0)
  dependencies String[]
  status       String   @default("todo")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, story_id])
}

// VF-FIN-001: Core Accounting
model GLAccount {
  id               String    @id @default(uuid()) @db.Uuid
  company_id       String    @db.Uuid
  code             String // e.g., "1000", "5000"
  name             String
  description      String?
  type             String // asset, liability, equity, revenue, expense
  category         String?
  subtype          String?
  parent_id        String?   @db.Uuid
  is_header        Boolean   @default(false)
  is_contra        Boolean   @default(false)
  is_active        Boolean   @default(true)
  normal_balance   String?
  sensitivity_tier String?   @default("T3")
  fs_placement     String?
  account_owner_id String?   @db.Uuid
  budget_enabled   Boolean   @default(false)
  tax_treatment    String?
  level            Int       @default(1)
  full_path        String?
  dormant_since    DateTime?
  sunset_candidate Boolean   @default(false)
  created_by       String?   @db.Uuid
  modified_by      String?   @db.Uuid
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  company       Company     @relation(fields: [company_id], references: [id])
  parent        GLAccount?  @relation("GLAccountHierarchy", fields: [parent_id], references: [id])
  children      GLAccount[] @relation("GLAccountHierarchy")
  owner         Employee?   @relation("GLAccountOwner", fields: [account_owner_id], references: [id])
  journal_lines JournalLine[]

  @@unique([company_id, code])
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  entry_date  DateTime
  description String?
  reference   String?
  status      String   @default("draft") // draft, posted, reversed
  period_id   String?  @db.Uuid
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company Company           @relation(fields: [company_id], references: [id])
  lines   JournalLine[]
  period  AccountingPeriod? @relation(fields: [period_id], references: [id])
  bankReconciliationMatches BankReconciliationMatch[]
}

model JournalLine {
  id         String  @id @default(uuid()) @db.Uuid
  entry_id   String  @db.Uuid
  account_id String  @db.Uuid
  debit      Decimal @default(0) @db.Decimal(15, 2)
  credit     Decimal @default(0) @db.Decimal(15, 2)
  narration  String?

  entry   JournalEntry @relation(fields: [entry_id], references: [id])
  account GLAccount    @relation(fields: [account_id], references: [id])
}

model AccountingPeriod {
  id         String    @id @default(uuid()) @db.Uuid
  company_id String    @db.Uuid
  year       Int
  month      Int
  status     String    @default("open") // open, closed
  closed_at  DateTime?
  closed_by  String?   @db.Uuid
  created_at DateTime  @default(now())

  company         Company        @relation(fields: [company_id], references: [id])
  journal_entries JournalEntry[]

  @@unique([company_id, year, month])
}

model BankStatement {
  id              String   @id @default(uuid()) @db.Uuid
  company_id      String   @db.Uuid
  account_id      String?  @db.Uuid
  statement_date  DateTime
  opening_balance Decimal  @db.Decimal(15, 2)
  closing_balance Decimal  @db.Decimal(15, 2)
  file_url        String?
  created_at      DateTime @default(now())

  company Company             @relation(fields: [company_id], references: [id])
  lines   BankStatementLine[]
  reconciliation_matches BankReconciliationMatch[]
}

model BankStatementLine {
  id           String   @id @default(uuid()) @db.Uuid
  statement_id String   @db.Uuid
  date         DateTime
  description  String
  amount       Decimal  @db.Decimal(15, 2)
  balance      Decimal  @db.Decimal(15, 2)
  reference    String?

  statement BankStatement @relation(fields: [statement_id], references: [id])
  reconciliation_match BankReconciliationMatch?
}

model BankReconciliationMatch {
  id              String   @id @default(uuid()) @db.Uuid
  company_id      String   @db.Uuid
  statement_id    String   @db.Uuid
  line_id         String   @unique @db.Uuid
  journal_entry_id String   @db.Uuid
  matched_by      String?  @db.Uuid
  matched_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  company       Company          @relation(fields: [company_id], references: [id])
  statement     BankStatement     @relation(fields: [statement_id], references: [id])
  line          BankStatementLine @relation(fields: [line_id], references: [id])
  journal_entry JournalEntry      @relation(fields: [journal_entry_id], references: [id])
  matched_by_user User?           @relation(fields: [matched_by], references: [id])
}

model TrialBalance {
  id           String   @id @default(uuid()) @db.Uuid
  company_id   String   @db.Uuid
  period_id    String   @db.Uuid
  generated_at DateTime @default(now())
  data         Json

  company Company @relation(fields: [company_id], references: [id])
}

// VF-FIN-002: Accounts Payable
model Vendor {
  id              String   @id @default(uuid()) @db.Uuid
  company_id      String   @db.Uuid
  name            String
  registration_no String?
  tax_pin         String?
  bank_details    Json? // { account_name, account_number, bank_name, branch_code, swift }
  payment_terms   String?
  status          String   @default("active")
  tier            String? // e.g., Preferred, Standard
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  company         Company           @relation(fields: [company_id], references: [id])
  purchase_orders PurchaseOrder[]
  invoices        Invoice[]
  statements      VendorStatement[]
  ap_requisitions APRequisition[]
  ap_manual_entries APManualEntry[]
}

model PurchaseOrder {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  vendor_id   String   @db.Uuid
  raised_by   String?  @db.Uuid
  status      String   @default("draft") // draft, approved, received, cancelled
  items       Json // Array of items
  total       Decimal  @db.Decimal(15, 2)
  approved_by String?  @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company        Company        @relation(fields: [company_id], references: [id])
  vendor         Vendor         @relation(fields: [vendor_id], references: [id])
  invoices       Invoice[]
  goods_receipts GoodsReceipt[]
}

model Invoice {
  id           String   @id @default(uuid()) @db.Uuid
  company_id   String   @db.Uuid
  vendor_id    String   @db.Uuid
  po_id        String?  @db.Uuid
  invoice_no   String
  invoice_date DateTime
  due_date     DateTime
  amount       Decimal  @db.Decimal(15, 2)
  status       String   @default("pending") // pending, matched, approved, paid
  ocr_data     Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company        @relation(fields: [company_id], references: [id])
  vendor  Vendor         @relation(fields: [vendor_id], references: [id])
  po      PurchaseOrder? @relation(fields: [po_id], references: [id])

  payment_run_id String?     @db.Uuid
  payment_run    PaymentRun? @relation(fields: [payment_run_id], references: [id])
  ap_match_exceptions APMatchException[]
}

model GoodsReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  company_id     String   @db.Uuid
  po_id          String   @db.Uuid
  received_by    String?  @db.Uuid
  received_date  DateTime
  items_received Json
  created_at     DateTime @default(now())

  company Company       @relation(fields: [company_id], references: [id])
  po      PurchaseOrder @relation(fields: [po_id], references: [id])
}

model PaymentRun {
  id            String   @id @default(uuid()) @db.Uuid
  company_id    String   @db.Uuid
  run_date      DateTime
  total_amount  Decimal  @db.Decimal(15, 2)
  bank_file_url String?
  status        String   @default("draft") // draft, approved, completed
  approved_by   String?  @db.Uuid
  created_at    DateTime @default(now())

  company  Company   @relation(fields: [company_id], references: [id])
  invoices Invoice[]
}

model VendorStatement {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  vendor_id  String   @db.Uuid
  period     String
  balance    Decimal  @db.Decimal(15, 2)
  file_url   String?
  created_at DateTime @default(now())

