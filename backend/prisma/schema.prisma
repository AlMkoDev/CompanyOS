  assigned_to Employee?         @relation(name: "AssignedTickets", fields: [assigned_to_id], references: [id])
  asset       ITAsset?          @relation(fields: [asset_id], references: [id])
  change      ChangeRequest?    @relation(fields: [change_id], references: [id])
  major_log   MajorIncidentLog?
}

model ITAsset {
  id              String    @id @default(uuid()) @db.Uuid
  company_id      String    @db.Uuid
  asset_tag       String    @unique
  name            String
  type            String // laptop, server, software_license
  assigned_to_id  String?   @db.Uuid
  status          String    @default("active")
  serial_no       String?
  model           String?
  purchase_date   DateTime?
  warranty_expiry DateTime?
  specs           Json? // { cpu, ram, storage }
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  company     Company    @relation(fields: [company_id], references: [id])
  assigned_to Employee?  @relation(fields: [assigned_to_id], references: [id])
  tickets     ITTicket[]
}

model ChangeRequest {
  id             String    @id @default(uuid()) @db.Uuid
  company_id     String    @db.Uuid
  raised_by_id   String    @db.Uuid
  title          String
  description    String
  reason         String
  impact         String
  risk           String
  status         String    @default("draft") // draft, pending_cab, approved, rejected, implemented, closed
  cab_notes      String?
  implemented_at DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  company   Company    @relation(fields: [company_id], references: [id])
  raised_by Employee   @relation(fields: [raised_by_id], references: [id])
  tickets   ITTicket[]
}

model KnowledgeArticle {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  author_id  String   @db.Uuid
  title      String
  content    String   @db.Text
  category   String
  tags       String[]
  views      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company  @relation(fields: [company_id], references: [id])
  author  Employee @relation(fields: [author_id], references: [id])
}

model MajorIncidentLog {
  id              String    @id @default(uuid()) @db.Uuid
  ticket_id       String    @unique @db.Uuid
  rca             String?
  impact_summary  String?
  prevention_plan String?
  detected_at     DateTime
  resolved_at     DateTime?
  mttr_seconds    Int?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  ticket ITTicket @relation(fields: [ticket_id], references: [id])
}

// VF-STR-001: OKRs
model OKRCycle {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  name       String
  start_date DateTime
  end_date   DateTime
  status     String   @default("draft") // draft, active, complete

  company    Company     @relation(fields: [company_id], references: [id])
  objectives Objective[]
}

model Objective {
  id            String  @id @default(uuid()) @db.Uuid
  cycle_id      String  @db.Uuid
  department_id String? @db.Uuid
  owner_id      String? @db.Uuid
  parent_id     String? @db.Uuid
  title         String
  description   String?
  progress      Int     @default(0)

  cycle       OKRCycle    @relation(fields: [cycle_id], references: [id])
  owner       Employee?   @relation("ObjectiveOwner", fields: [owner_id], references: [id])
  parent      Objective?  @relation("ObjectiveCascade", fields: [parent_id], references: [id])
  children    Objective[] @relation("ObjectiveCascade")
  key_results KeyResult[]
}

model KeyResult {
  id            String    @id @default(uuid()) @db.Uuid
  objective_id  String    @db.Uuid
  title         String
  unit          String    @default("percentage") // percentage, currency, count
  initial_value Decimal   @db.Decimal(15, 2)
  target_value  Decimal   @db.Decimal(15, 2)
  current_value Decimal   @db.Decimal(15, 2)
  target_date   DateTime?
  status        String    @default("on-track")

  objective Objective @relation(fields: [objective_id], references: [id])
  check_ins CheckIn[]
}

model CheckIn {
  id         String   @id @default(uuid()) @db.Uuid
  kr_id      String   @db.Uuid
  value      Decimal  @db.Decimal(15, 2)
  confidence Int // 1-10
  comment    String?
  created_at DateTime @default(now())

  key_result KeyResult @relation(fields: [kr_id], references: [id])
}

// VF-STR-002: BI
model KPISnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  kpi_id      String   @db.Uuid
  value       Decimal  @db.Decimal(15, 2)
  recorded_at DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id])
}

// VF-ADM-001: DMS Improvements
model Folder {
  id             String   @id @default(uuid()) @db.Uuid
  company_id     String   @db.Uuid
  name           String
  parent_id      String?  @db.Uuid
  security_level String   @default("public")
  metadata       Json?
  created_at     DateTime @default(now())

  company   Company    @relation(fields: [company_id], references: [id])
  parent    Folder?    @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children  Folder[]   @relation("FolderHierarchy")
  documents Document[]
}

model DocumentVersion {
  id         String   @id @default(uuid()) @db.Uuid
  doc_id     String   @db.Uuid
  version_no Int
  file_url   String
  change_log String?
  created_at DateTime @default(now())
  created_by String   @db.Uuid

  document Document @relation(fields: [doc_id], references: [id])
}

model RetentionPolicy {
  id             String @id @default(uuid()) @db.Uuid
  company_id     String @db.Uuid
  name           String
  duration_years Int
  trigger_event  String @default("creation") // creation, last_access
  category       String

  company   Company    @relation(fields: [company_id], references: [id])
  documents Document[]
}

model LegalHold {
  id         String   @id @default(uuid()) @db.Uuid
  doc_id     String   @db.Uuid
  reason     String
  active     Boolean  @default(true)
  placed_by  String   @db.Uuid
  created_at DateTime @default(now())

  document Document @relation(fields: [doc_id], references: [id])
}

// VF-ADM-002: Procurement & PO


model SpendRecord {
  id            String   @id @default(uuid()) @db.Uuid
  company_id    String   @db.Uuid
  department_id String   @db.Uuid
  amount        Decimal  @db.Decimal(15, 2)
  category      String
  recorded_at   DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id])
}

// VF-ADM-003: Travel & Expense
model TravelRequest {
  id             String   @id @default(uuid()) @db.Uuid
  company_id     String   @db.Uuid
  employee_id    String   @db.Uuid
  destination    String
  purpose        String
  start_date     DateTime
  end_date       DateTime
  status         String   @default("pending") // pending, approved, rejected, completed
  estimated_cost Decimal? @db.Decimal(15, 2)

  company Company @relation(fields: [company_id], references: [id])
}

model ExpenseClaim {
  id          String  @id @default(uuid()) @db.Uuid
  company_id  String  @db.Uuid
  employee_id String  @db.Uuid
  amount      Decimal @db.Decimal(15, 2)
  description String
  status      String  @default("submitted") // submitted, approved, paid
  receipt_url String?

  company Company @relation(fields: [company_id], references: [id])
}

// VF-ADM-004: Fleet
model Vehicle {
  id         String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  reg_no     String @unique
  make       String
  model      String
  type       String // truck, car, van, ag-equipment
  status     String @default("available") // available, booked, maintenance

  company     Company        @relation(fields: [company_id], references: [id])
  bookings    FleetBooking[]
  fuelRecords FuelRecord[]
}

model FleetBooking {
  id         String   @id @default(uuid()) @db.Uuid
  vehicle_id String   @db.Uuid
  driver_id  String   @db.Uuid
  start_at   DateTime
  end_at     DateTime
  purpose    String?

  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])
}

model FuelRecord {
  id         String   @id @default(uuid()) @db.Uuid
  vehicle_id String   @db.Uuid
  date       DateTime
  liters     Decimal  @db.Decimal(10, 2)
  amount     Decimal  @db.Decimal(15, 2)
  odometer   Int

  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])
}

// ============================================================================
// VF-OPS-001 — Project & Portfolio Management Module
// Complete Prisma Schema (Base + Premium Models)
// ============================================================================
// Implements: DB-01 (Base PPM), DB-02 (Premium PPM)
// Sprint 1 Foundation - All models for Tier 1-5 capabilities
// ============================================================================

// ----------------------------
// ENUMS (All PPM Enumerations)
// ----------------------------

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum RAGStatus {
  GREEN
  AMBER
  RED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RAIDType {
  RISK
  ACTION
  ISSUE
  DECISION
}

enum DependencyType {
  FINISH_TO_START // FTS - Most common
  START_TO_START // STS
  FINISH_TO_FINISH // FTF
}

enum GateStatus {
  PENDING
  PASSED
  FAILED
  WAIVED
}

enum DecisionStatus {
  PROPOSED
  APPROVED
  SUPERSEDED
}

enum InsightType {
  PATTERN_MATCH
  ESTIMATION_DRIFT
  RESOURCE_RISK
  SCHEDULE_RISK
  QUALITY_RISK
}

enum LessonCategory {
  PROCESS
  TECHNICAL
  PEOPLE
  RISK
}

enum ProficiencyLevel {
  BEGINNER
  PRACTITIONER
  EXPERT
  LEAD
}

// ----------------------------
// CORE PROJECT MODELS (DB-01)
// ----------------------------

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  company_id  String        @db.Uuid
  name        String
  description String?       @db.Text
  start_date  DateTime
  end_date    DateTime?
  status      ProjectStatus @default(PLANNED)
  rag_status  RAGStatus     @default(GREEN)
  owner_id    String?       @db.Uuid

  // Financial tracking
  budget_allocated    Decimal? @db.Decimal(15, 2)
  budget_spent        Decimal? @db.Decimal(15, 2)
  budget_variance_pct Decimal? @db.Decimal(5, 2) // Percentage variance

  // Health metrics (Tier 5)
  health_score Int? // 0-100 composite score

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  company           Company              @relation(fields: [company_id], references: [id])
  owner             Employee?            @relation("ProjectOwner", fields: [owner_id], references: [id])
  tasks             ProjectTask[]
  raid_items        RAIDItem[]
  budgets           ProjectBudget[]
  assignments       ResourceAssignment[]
  milestones        ProjectMilestone[]
  phases            ProjectPhase[]
  baselines         ProjectBaseline[]
  gates             GateReview[]
  decisions         DecisionRecord[]
  dependencies_from ProjectDependency[]  @relation("FromProject")
  dependencies_to   ProjectDependency[]  @relation("ToProject")
  forecasts         ProjectForecast[]
  insights          ProjectInsight[]
  lessons           Lesson[]
  audit_logs        ProjectAuditLog[]
  resource          Resource?            @relation(fields: [resourceId], references: [id])
  resourceId        String?              @db.Uuid
  sprintRecords     SprintRecord[]

  @@index([company_id])
  @@index([rag_status])
  @@index([owner_id])
}

model ProjectTask {
  id           String     @id @default(uuid()) @db.Uuid
  project_id   String     @db.Uuid
  title        String
  description  String?    @db.Text
  assignee_id  String?    @db.Uuid
  due_date     DateTime?
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  completed_at DateTime?
  blocked_by   String?    @db.Text // Reason if BLOCKED

  // Cycle time tracking (for Monte Carlo)
  started_at      DateTime?
  cycle_time_days Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project  Project   @relation(fields: [project_id], references: [id])
  assignee Employee? @relation("TaskAssignee", fields: [assignee_id], references: [id])

  @@index([project_id])
  @@index([assignee_id])
  @@index([status])
}

model RAIDItem {
  id          String    @id @default(uuid()) @db.Uuid
  project_id  String    @db.Uuid
  type        RAIDType
  title       String
  description String    @db.Text
  mitigation  String?   @db.Text
  owner_id    String?   @db.Uuid
  status      String    @default("OPEN") // OPEN, MITIGATED, CLOSED
  severity    Priority
  logged_date DateTime  @default(now()) // For Gantt flag positioning
  closed_at   DateTime?

  // Decision-specific fields (T4.2)
  options_considered Json? // Array of {option, pros, cons}
  rationale          String?   @db.Text
  approved_by_id     String?   @db.Uuid
  approved_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project Project   @relation(fields: [project_id], references: [id])
  owner   Employee? @relation("RAIDOwner", fields: [owner_id], references: [id])

  @@index([project_id])
  @@index([type])
  @@index([severity])
}

model ProjectBudget {
  id              String   @id @default(uuid()) @db.Uuid
  project_id      String   @db.Uuid
  total_allocated Decimal  @db.Decimal(15, 2)
  actual_spent    Decimal  @db.Decimal(15, 2)
  variance        Decimal  @db.Decimal(15, 2)
  variance_pct    Decimal  @db.Decimal(5, 2)
  last_updated    DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
}

model ResourceAssignment {
  id                 String    @id @default(uuid()) @db.Uuid
  project_id         String    @db.Uuid
  user_id            String    @db.Uuid
  role               String // PM, TEAM_MEMBER, CONTRIBUTOR, VIEWER
  allocation_percent Int       @default(100) // 0-100%
  allocated_hours    Int // Total hours allocated
  start_date         DateTime
  end_date           DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project Project  @relation(fields: [project_id], references: [id])
  user    Employee @relation("ResourceAssignee", fields: [user_id], references: [id])

  @@index([project_id])
  @@index([user_id])
}

// ----------------------------
// PREMIUM MODELS (DB-02)
// ----------------------------

// Tier 1: Strategic Planning Layer

model ProjectMilestone {
  id            String    @id @default(uuid()) @db.Uuid
  project_id    String    @db.Uuid
  title         String
  target_date   DateTime
  achieved_date DateTime?
  description   String?   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@index([target_date])
}

model ProjectPhase {
  id         String    @id @default(uuid()) @db.Uuid
  project_id String    @db.Uuid
  name       String
  start_date DateTime
  end_date   DateTime?
  status     String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
}

model ProjectBaseline {
  id             String   @id @default(uuid()) @db.Uuid
  project_id     String   @db.Uuid
  baseline_name  String // "Initial Plan", "Q2 Rebaseline", etc.
  snapshot_data  Json // Full project state snapshot
  approved_at    DateTime
  approved_by_id String   @db.Uuid

  created_at DateTime @default(now())

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
}

model ProjectDependency {
  id              String         @id @default(uuid()) @db.Uuid
  from_project_id String         @db.Uuid // Upstream project
  to_project_id   String         @db.Uuid // Downstream project
  dependency_type DependencyType
  lag_days        Int            @default(0)
  description     String?        @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  from_project Project @relation("FromProject", fields: [from_project_id], references: [id])
  to_project   Project @relation("ToProject", fields: [to_project_id], references: [id])

  @@unique([from_project_id, to_project_id]) // Prevent duplicates
  @@index([from_project_id])
  @@index([to_project_id])
}

// Tier 3: Delivery Intelligence

model SprintRecord {
  id               String   @id @default(uuid()) @db.Uuid
  project_id       String   @db.Uuid
  sprint_number    Int
  planned_points   Int
  completed_points Int
  start_date       DateTime
  end_date         DateTime

  created_at DateTime @default(now())

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@index([sprint_number])
}

model CycleTimeLog {
  id           String   @id @default(uuid()) @db.Uuid
  task_id      String   @db.Uuid
  started_at   DateTime
  completed_at DateTime
  cycle_days   Int

  created_at DateTime @default(now())

  // Relations
  // Note: Can't link to ProjectTask directly to avoid circular dependency

  @@index([task_id])
  @@index([cycle_days])
}

model ProjectForecast {
  id               String   @id @default(uuid()) @db.Uuid
  project_id       String   @db.Uuid
  forecast_date    DateTime @default(now())
  p50_date         DateTime // 50% confidence delivery date
  p85_date         DateTime // 85% confidence delivery date
  p95_date         DateTime // 95% confidence delivery date
  confidence_level String // LOW, MEDIUM, HIGH (based on data sufficiency)
  simulations_run  Int      @default(10000)

  created_at DateTime @default(now())

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
}

model ProjectInsight {
  id                 String      @id @default(uuid()) @db.Uuid
  project_id         String      @db.Uuid
  insight_type       InsightType
  confidence         Float // 0.0-1.0
  description        String      @db.Text
  detected_at        DateTime    @default(now())
  acknowledged       Boolean     @default(false)
  acknowledged_by_id String?     @db.Uuid
  acknowledged_at    DateTime?

  created_at DateTime @default(now())

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@index([insight_type])
}

// Tier 4: Stakeholder Engagement

model GateReview {
  id                 String     @id @default(uuid()) @db.Uuid
  project_id         String     @db.Uuid
  gate_name          String // "Discovery Complete", "Design Approved", "Ready to Launch"
  gate_order         Int // Sequential order
  entry_criteria     Json // Array of criteria strings
  exit_criteria      Json // Array of criteria strings
  required_approvers Json // Array of userIds
  status             GateStatus @default(PENDING)
  outcome            String?    @db.Text
  outcome_date       DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@index([gate_order])
}

model DecisionRecord {
  id                 String         @id @default(uuid()) @db.Uuid
  project_id         String         @db.Uuid
  title              String
  context            String         @db.Text
  options_considered Json // Array of {option, pros, cons}
  chosen_option      String         @db.Text
  rationale          String         @db.Text
  approved_by_id     String?        @db.Uuid
  approved_at        DateTime?
  status             DecisionStatus @default(PROPOSED)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
}

// Tier 2: Resource Intelligence

model UserSkill {
  id                 String           @id @default(uuid()) @db.Uuid
  user_id            String           @db.Uuid
  skill_name         String
  proficiency        ProficiencyLevel
  years_experience   Int?
  certified          Boolean          @default(false)
  certification_name String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user Employee @relation("UserSkills", fields: [user_id], references: [id])

  @@index([user_id])
  @@index([skill_name])
}

model Capacity {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  week_start      DateTime
  available_hours Int
  allocated_hours Int
  overallocated   Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user Employee @relation("CapacityRecords", fields: [user_id], references: [id])

  @@index([user_id])
  @@index([week_start])
}

// Tier 5: Intelligence & Automation

model Lesson {
  id             String         @id @default(uuid()) @db.Uuid
  project_id     String         @db.Uuid
  category       LessonCategory
  title          String
  description    String         @db.Text
  recommendation String         @db.Text
  raid_item_id   String?        @db.Uuid // Link back to RAID if applicable
  milestone_id   String?        @db.Uuid // Link to milestone if applicable

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@index([category])
}

model ProjectAuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  project_id     String  @db.Uuid
  user_id        String  @db.Uuid
  action         String // CREATE, UPDATE, STATE_CHANGE, BUDGET_UPDATE, etc.
  previous_value Json?
  new_value      Json?
  ip_address     String?
  user_agent     String?

  created_at DateTime @default(now())

  // Relations
  project Project  @relation(fields: [project_id], references: [id])
  user    Employee @relation("ProjectAuditLogs", fields: [user_id], references: [id])

  @@index([project_id])
  @@index([user_id])
  @@index([action])
  @@index([created_at])
}

// VF-OPS-003: Supply Chain & Inventory Management
model ApprovalPolicy {
  id                 String  @id @default(uuid()) @db.Uuid
  company_id         String  @db.Uuid
  product_category   String
  auto_approve_limit Decimal @db.Decimal(15, 2)
  l1_threshold       Decimal @db.Decimal(15, 2)
  l2_threshold       Decimal @db.Decimal(15, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, product_category])
}

// Enums for Supply Chain
enum SupplierStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum LedgerEntryType {
  OPENING_BALANCE
  PO_RECEIPT
  RETURN_TO_SUPPLIER
  STOCK_ADJUSTMENT_UP
  STOCK_ADJUSTMENT_DOWN
  TRANSFER_IN
  TRANSFER_OUT
  FULFILLMENT
  CYCLE_COUNT
  SCRAP
}

enum PRStatus {
  DRAFT
  PENDING_L1
  PENDING_L2
  APPROVED
  REJECTED
  CANCELLED
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIAL
  FULLY_RECEIVED
  CANCELLED
  CLOSED
}

enum AmendmentStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

enum GRStatus {
  DRAFT
  SUBMITTED
  DISCREPANCY
  COMPLETED
}

// DB-01 Models

model Supplier {
  id              String         @id @default(uuid()) @db.Uuid
  company_id      String         @db.Uuid
  supplier_code   String
  name            String
  status          SupplierStatus @default(ACTIVE)
  contact_info    Json?
  bank_details    Json?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  company         Company        @relation(fields: [company_id], references: [id])
  products        SupplierProduct[]
  purchase_orders OpsPurchaseOrder[]
  risks           SupplierRisk[]
  bank_change_requests BankChangeRequest[]

  @@unique([company_id, supplier_code])
}

model Product {
  id              String         @id @default(uuid()) @db.Uuid
  company_id      String         @db.Uuid
  sku             String
  name            String
  description     String?
  category        String?
  unit_of_measure String
  abc_class       String?        // A, B, C
  xyz_class       String?        // X, Y, Z
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  company         Company        @relation(fields: [company_id], references: [id])
  suppliers       SupplierProduct[]
  stock_levels    StockLevel[]
  stock_ledger    StockLedger[]
  pr_lines        PRLineItem[]
  po_lines        POLineItem[]
  gr_lines        GRLineItem[]
  forecasts       DemandForecast[]
  cycle_counts    CycleCount[]
  cogs_records    COGSRecord[]

  @@unique([company_id, sku])
}

model Location {
  id              String         @id @default(uuid()) @db.Uuid
  company_id      String         @db.Uuid
  name            String
  address         String?
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  company         Company        @relation(fields: [company_id], references: [id])
  stock_levels    StockLevel[]
  stock_ledger    StockLedger[]
  goods_receipts  OpsGoodsReceipt[]
  forecasts       DemandForecast[]
  cycle_counts    CycleCount[]
}

model StockLevel {
  id              String   @id @default(uuid()) @db.Uuid
  company_id      String   @db.Uuid
  product_id      String   @db.Uuid
  location_id     String   @db.Uuid
  quantity        Decimal  @default(0) @db.Decimal(15, 2)
  reorder_point   Decimal? @db.Decimal(15, 2)
  eoq             Decimal? @db.Decimal(15, 2)
  cache_updated_at DateTime @default(now())

  company   Company   @relation(fields: [company_id], references: [id])
  product   Product   @relation(fields: [product_id], references: [id])
  location  Location  @relation(fields: [location_id], references: [id])

  @@unique([company_id, product_id, location_id])
}

model StockLedger {
  id              String          @id @default(uuid()) @db.Uuid
  company_id      String          @db.Uuid
  product_id      String          @db.Uuid
  location_id     String          @db.Uuid
  entry_type      LedgerEntryType
  quantity_change Decimal         @db.Decimal(15, 2)
  reference_id    String?         // ID of PO, GR, PR, etc.
  reason_code     String?
  user_id         String?         @db.Uuid
  created_at      DateTime        @default(now())
  // No update/delete endpoints by design!

  company   Company   @relation(fields: [company_id], references: [id])
  product   Product   @relation(fields: [product_id], references: [id])
  location  Location  @relation(fields: [location_id], references: [id])
}

model PurchaseRequisition {
  id              String         @id @default(uuid()) @db.Uuid
  company_id      String         @db.Uuid
  pr_number       String
  requester_id    String         @db.Uuid
  status          PRStatus       @default(DRAFT)
  justification   String?
  department_id   String?        @db.Uuid
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  company   Company      @relation(fields: [company_id], references: [id])
  requester Employee     @relation("Requester", fields: [requester_id], references: [id])
  lines     PRLineItem[]
  purchase_orders OpsPurchaseOrder[]
  
  @@unique([company_id, pr_number])
}

model PRLineItem {
  id              String              @id @default(uuid()) @db.Uuid
  pr_id           String              @db.Uuid
  product_id      String              @db.Uuid
  quantity        Decimal             @db.Decimal(15, 2)
  estimated_cost  Decimal?            @db.Decimal(15, 2)
  
  pr        PurchaseRequisition @relation(fields: [pr_id], references: [id])
  product   Product             @relation(fields: [product_id], references: [id])
}

model OpsPurchaseOrder {
  id              String         @id @default(uuid()) @db.Uuid
  company_id      String         @db.Uuid
  po_number       String
  supplier_id     String         @db.Uuid
  status          POStatus       @default(DRAFT)
  pr_id           String?        @db.Uuid
  pdf_url         String?
  total_value     Decimal        @default(0) @db.Decimal(15, 2)
  amendment_count Int            @default(0)
  last_amended_at DateTime?
  is_amended      Boolean        @default(false)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  company           Company             @relation(fields: [company_id], references: [id])
  supplier          Supplier            @relation(fields: [supplier_id], references: [id])
  purchase_requisition PurchaseRequisition? @relation(fields: [pr_id], references: [id])
  lines             POLineItem[]
  goods_receipts    OpsGoodsReceipt[]
  amendments        POAmendment[]
  supplier_invoices SupplierInvoice[]

  @@unique([company_id, po_number])
}

model POLineItem {
  id              String           @id @default(uuid()) @db.Uuid
  po_id           String           @db.Uuid
  product_id      String           @db.Uuid
  quantity        Decimal          @db.Decimal(15, 2)
  unit_price      Decimal          @db.Decimal(15, 2)
  received_qty    Decimal          @default(0) @db.Decimal(15, 2)
  
  po        OpsPurchaseOrder @relation(fields: [po_id], references: [id])
  product   Product          @relation(fields: [product_id], references: [id])
}

model OpsGoodsReceipt {
  id              String           @id @default(uuid()) @db.Uuid
  company_id      String           @db.Uuid
  gr_number       String
  po_id           String           @db.Uuid
  location_id     String           @db.Uuid
  status          GRStatus         @default(DRAFT)
  received_by     String?          @db.Uuid
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  company   Company          @relation(fields: [company_id], references: [id])
  po        OpsPurchaseOrder @relation(fields: [po_id], references: [id])
  location  Location         @relation(fields: [location_id], references: [id])
  receiver  Employee?        @relation("Receiver", fields: [received_by], references: [id])
  lines     GRLineItem[]

  @@unique([company_id, gr_number])
}

model GRLineItem {
  id              String           @id @default(uuid()) @db.Uuid
  gr_id           String           @db.Uuid
  product_id      String           @db.Uuid
  received_qty    Decimal          @db.Decimal(15, 2)
  rejected_qty    Decimal          @default(0) @db.Decimal(15, 2)
  rejection_reason String?

  gr        OpsGoodsReceipt  @relation(fields: [gr_id], references: [id])
  product   Product          @relation(fields: [product_id], references: [id])
  supplier_rejections SupplierRejection[]
}

// DB-02 Models

model SupplierRejection {
  id              String      @id @default(uuid()) @db.Uuid
  gr_line_id      String      @db.Uuid
  reason          String
  quantity        Decimal     @db.Decimal(15, 2)
  created_at      DateTime    @default(now())

  gr_line   GRLineItem  @relation(fields: [gr_line_id], references: [id])
}

model POAmendment {
  id                    String          @id @default(uuid()) @db.Uuid
  company_id            String          @db.Uuid
  amendment_number      String          @unique
  original_po_id        String          @db.Uuid
  requested_by          String
  reason                String
  justification         String
  urgency               String          @default("MEDIUM")
  status                AmendmentStatus @default(PENDING)
  original_total        Decimal         @db.Decimal(15, 2)
  amended_total         Decimal         @db.Decimal(15, 2)
  changes               Json
  approved_by           String?
  approved_at           DateTime?
  approval_comments     String?
  applied_by            String?
  applied_at            DateTime?
  cancelled_by          String?
  cancelled_at          DateTime?
  cancellation_reason   String?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  company     Company          @relation(fields: [company_id], references: [id])
  original_po OpsPurchaseOrder @relation(fields: [original_po_id], references: [id])
  audit_logs  POAmendmentAudit[]

  @@index([company_id])
  @@index([original_po_id])
  @@index([status])
}

model POAmendmentAudit {
  id           String   @id @default(uuid()) @db.Uuid
  company_id   String   @db.Uuid
  amendment_id String   @db.Uuid
  action       String
  performed_by String
  description  String
  metadata     Json?
  created_at   DateTime @default(now())

  company   Company     @relation(fields: [company_id], references: [id])
  amendment POAmendment @relation(fields: [amendment_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([amendment_id])
  @@index([created_at])
}

model SupplierProduct {
  id              String      @id @default(uuid()) @db.Uuid
  supplier_id     String      @db.Uuid
  product_id      String      @db.Uuid
  unit_cost       Decimal     @db.Decimal(15, 2)
  lead_time_days  Int
  is_preferred    Boolean     @default(false)
  
  supplier  Supplier    @relation(fields: [supplier_id], references: [id])
  product   Product     @relation(fields: [product_id], references: [id])

  @@unique([supplier_id, product_id])
}

model SupplierRisk {
  id              String      @id @default(uuid()) @db.Uuid
  supplier_id     String      @db.Uuid
  risk_score      Int
  category        String      // single_source, financial, quality
  details         String?
  created_at      DateTime    @default(now())

  supplier  Supplier    @relation(fields: [supplier_id], references: [id])
}

model SupplierInvoice {
  id              String           @id @default(uuid()) @db.Uuid
  company_id      String           @db.Uuid
  po_id           String           @db.Uuid
  invoice_number  String
  total_amount    Decimal          @db.Decimal(15, 2)
  status          String           @default("PENDING_MATCH")
  created_at      DateTime         @default(now())

  po        OpsPurchaseOrder @relation(fields: [po_id], references: [id])
}

model UnmatchedReceipt {
  id              String      @id @default(uuid()) @db.Uuid
  company_id      String      @db.Uuid
  details         Json
  status          String      @default("PENDING_FINANCE_APPROVAL")
  created_at      DateTime    @default(now())
}

model DemandForecast {
  id              String      @id @default(uuid()) @db.Uuid
  product_id      String      @db.Uuid
  location_id     String      @db.Uuid
  forecast_date   DateTime
  predicted_qty   Decimal     @db.Decimal(15, 2)
  window_days     Int         // 30, 60, 90
  confidence      Float

  product   Product     @relation(fields: [product_id], references: [id])
  location  Location    @relation(fields: [location_id], references: [id])
}

model SeasonalAdjustment {
  id              String      @id @default(uuid()) @db.Uuid
  product_category String
  month           Int         // 1-12
  multiplier      Float
}

model CycleCount {
  id              String      @id @default(uuid()) @db.Uuid
  product_id      String      @db.Uuid
  location_id     String      @db.Uuid
  scheduled_date  DateTime
  counted_qty     Decimal?    @db.Decimal(15, 2)
  variance        Decimal?    @db.Decimal(15, 2)
  status          String      @default("SCHEDULED")

  product   Product     @relation(fields: [product_id], references: [id])
  location  Location    @relation(fields: [location_id], references: [id])
}

model RFQ {
  id              String      @id @default(uuid()) @db.Uuid
  company_id      String      @db.Uuid
  description     String
  status          String      @default("OPEN")
  deadline        DateTime
  created_at      DateTime    @default(now())

  quotes    SupplierQuote[]
}

model SupplierQuote {
  id              String      @id @default(uuid()) @db.Uuid
  rfq_id          String      @db.Uuid
  supplier_id     String      @db.Uuid
  total_value     Decimal     @db.Decimal(15, 2)
  lead_time_days  Int
  is_selected     Boolean     @default(false)
  created_at      DateTime    @default(now())

  rfq       RFQ         @relation(fields: [rfq_id], references: [id])
}

model COGSRecord {
  id              String      @id @default(uuid()) @db.Uuid
  company_id      String      @db.Uuid
  product_id      String      @db.Uuid
  project_id      String?     @db.Uuid
  quantity        Decimal     @db.Decimal(15, 2)
  unit_cost       Decimal     @db.Decimal(15, 2)
  total_cost      Decimal     @db.Decimal(15, 2)
  created_at      DateTime    @default(now())

  product   Product     @relation(fields: [product_id], references: [id])
}
// Bank Detail Change Control Models
model BankChangeRequest {
  id                    String                    @id @default(uuid()) @db.Uuid
  supplier_id           String                    @db.Uuid
  current_bank_details  Json?
  proposed_bank_details Json
  requester_id          String                    @db.Uuid
  justification         String
  status                BankChangeRequestStatus   @default(PENDING)
  approver_id           String?                   @db.Uuid
  approval_comments     String?
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt

  supplier    Supplier  @relation(fields: [supplier_id], references: [id])
  requester   User      @relation("BankChangeRequester", fields: [requester_id], references: [id])
  approver    User?     @relation("BankChangeApprover", fields: [approver_id], references: [id])

  @@index([supplier_id])
  @@index([status])
  @@index([created_at])
}

enum BankChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
